# ════════════════════════════════════════════════════════════════
# Component Versions - DigitalOcean Laravel Runtime
# ════════════════════════════════════════════════════════════════

# PHP Version (Alpine variant)
PHP_VERSION=8.4-cli-alpine

# Composer Version
COMPOSER_VERSION=2

# OpenSwoole Version
SWOOLE_VERSION=25.2.0

# Cloudflared Version (optional - leave empty to skip installation)
# Not needed — cloudflared runs as separate container in DO App Platform
CLOUDFLARED_VERSION=

# Image Tag (automatically constructed from versions)
# Format: php{PHP_MAJOR}.{PHP_MINOR}-swoole{SWOOLE_VERSION}[-cloudflared{CLOUDFLARED_VERSION}]