# ════════════════════════════════════════════════════════════════
# Component Versions - DigitalOcean Laravel Runtime
# ════════════════════════════════════════════════════════════════

# PHP Version (Alpine variant) - default used when --php-version is not passed
PHP_VERSION=8.4-cli-alpine

# Supported PHP versions — documentation only, nothing reads this variable.
# The source of truth for CI is the matrix in .github/workflows/docker-publish.yml;
# adding a version here alone does NOT build it. The default one (8.4) also
# gets the bare `latest` tag.
PHP_VERSIONS="8.4-cli-alpine 8.5-cli-alpine"

# Composer Version
COMPOSER_VERSION=2

# Node.js major version (frontend asset building)
# 24 is the active LTS (maintenance until 2028-04-30); 22 is already in
# security-only maintenance. Pinned via the official node:<version>-alpine
# image so a future Alpine base bump cannot silently move the major.
NODE_VERSION=24

# OpenSwoole Version
# 26.x is required for PHP 8.5 (and drops PHP 8.2 support)
SWOOLE_VERSION=26.2.0

# Cloudflared Version (optional - leave empty to skip installation)
# Not needed — cloudflared runs as separate container in DO App Platform
CLOUDFLARED_VERSION=

# Image Tag (automatically constructed from versions)
# Format: php{PHP_MAJOR}.{PHP_MINOR}-swoole{SWOOLE_VERSION}[-cloudflared{CLOUDFLARED_VERSION}]
